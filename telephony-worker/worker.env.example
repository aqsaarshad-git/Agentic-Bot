# Copy to worker.env (same directory, on the box this runs on) and fill in real values.
# worker.env is gitignored — never commit it. Auto-loaded by worker.js on startup.

# FreeSWITCH's Event Socket — local only (loopback-only ACL on the reference box; worker.js
# runs ON that same box, so 127.0.0.1 always works regardless of how the box itself is reached).
ESL_HOST=127.0.0.1
ESL_PORT=8021
ESL_PASSWORD=ClueCon

# This worker's own tiny HTTP server — the main API calls POST /originate here. Bind to
# 127.0.0.1 and reach it from the API side over an SSH tunnel (see
# scripts/freeswitch-tunnel.sh) rather than exposing it on the box's real network interface.
WORKER_PORT=8005
WORKER_BIND=127.0.0.1

# Where the main NestJS API is reachable FROM this box. If the API runs somewhere this box
# can't dial into directly (e.g. a dev laptop behind NAT), point this at the box-local end of
# an SSH reverse tunnel instead (again, scripts/freeswitch-tunnel.sh sets exactly this up).
API_BASE_URL=http://127.0.0.1:13000

# Must match apps/api/.env's TELEPHONY_WORKER_SECRET on the API side EXACTLY.
TELEPHONY_WORKER_SECRET=

# Per-turn recording/playback WAV files — local to this box, this worker's own scratch space.
RECORDINGS_DIR=/tmp

# The FreeSWITCH sofia gateway name to originate outbound calls through — must already exist
# and be registered (check: fs_cli -x "sofia status gateway <name>"). On the reference box
# (192.168.5.133) the existing Connectel gateway is literally named "connecttel" (double t) —
# confirm with `ls /usr/local/freeswitch/conf/sip_profiles/external/` before assuming otherwise.
SIP_GATEWAY=connecttel

# Comma-separated list of DIDs (destination numbers) this project owns on the shared trunk.
# REQUIRED if this FreeSWITCH instance is shared with other products/tenants (event
# subscriptions are global, not scoped by gateway/DID) — an inbound CHANNEL_ANSWER for any
# number NOT in this list is ignored, left for whichever other product actually owns it.
INBOUND_DIDS=
