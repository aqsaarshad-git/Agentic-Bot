# MySQL (shared with root prisma schema). Special characters in the password
# (e.g. #, @, :) must be percent-encoded.
DATABASE_URL="mysql://root:password@localhost:3306/agentic_support"

# App
PORT=3000
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="30d"
CORS_ORIGIN="http://localhost:5173"

# Dev-only: this fixed code is ALWAYS accepted as a customer's OTP, in addition to the
# real generated one — avoids re-checking devOtp on every test run across days/sessions.
# Unset (or set NODE_ENV=production) to require the real per-request code only.
OTP_DEV_BYPASS_CODE="000000"

# LLM provider selection: "mock" | "qwen". If Qwen is served via Ollama (as in this
# project's actual GPU deployment — see your private setup notes, not committed here),
# point QWEN_BASE_URL at "<host>:<port>" (NO /v1 — use Ollama's NATIVE /api/chat, not its
# OpenAI-compatible layer: for this model, native + "think: false" measured ~10x faster
# than the OpenAI-compatible endpoint, which doesn't honor the think flag at all) and set
# QWEN_MODEL to the exact `ollama list` name (e.g. "qwen3.5:4b"). No API key needed for
# a local/tunneled Ollama. If the GPU host only exposes 127.0.0.1, reach it via an SSH
# local port-forward rather than exposing the port — never change the remote service's
# bind address or restart anything there. If you already run Ollama (or anything else)
# locally on the same port, ssh -L silently fails to bind that forward — pick a different
# local port (e.g. -L 21435:127.0.0.1:<remote-port>) and point QWEN_BASE_URL at that port
# instead; check `netstat`/`Get-NetTCPConnection` for what actually owns a "listening"
# local port before trusting it's your tunnel. On a SHARED GPU box, prefer whichever
# Ollama instance keeps your model permanently resident (OLLAMA_KEEP_ALIVE=-1) over one
# other tenants also use — a model that has to compete for GPU time with someone else's
# much larger model can effectively stop responding at all, not just run slower.
LLM_PROVIDER=mock
QWEN_BASE_URL=""
QWEN_API_KEY=""
QWEN_MODEL="qwen3.5"

# STT provider selection: "mock" | "cohere". Two different real deployments fit this
# adapter's contract (POST {baseUrl}/transcribe, multipart audio+language -> {text}):
# a self-hosted Cohere Transcribe Arabic instance behind your own thin server (this
# project's actual setup), or you can point it at a compatible wrapper in front of the
# public Cohere API. See your private setup notes for the actual base URL — same
# "never touch the remote service" rule as above if it's on a shared box.
STT_PROVIDER=mock
COHERE_STT_BASE_URL=""
COHERE_STT_API_KEY=""

# TTS provider selection: "mock" | "voxcpm2". VoxCPM2 (github.com/OpenBMB/VoxCPM) is
# self-hosted, not a hosted API — this adapter targets a simple GET {baseUrl}/speak?text=
# wrapper (this project's actual setup); vLLM-Omni's OpenAI-compatible /v1/audio/speech
# is another option if that's what's actually running instead.
TTS_PROVIDER=mock
VOXCPM2_BASE_URL=""

# Voice transport (LiveKit). Leave blank to keep calls in "no live audio" mode —
# Call/Conversation records and the STT->orchestrator->TTS pipeline still work via
# POST /calls/:id/turns, only the real-time audio room is unavailable until this is set.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Real PSTN calling. Off by default — everything above (browser calls, campaigns/callbacks)
# keeps working exactly as before either way. FreeSWITCH/ESL/Connectel themselves are handled
# entirely by a separate process, telephony-worker/worker.js, deployed on whatever box actually
# holds the live SIP trunk — this app only ever talks HTTP to that worker (normally over an SSH
# tunnel — see scripts/freeswitch-tunnel.sh), never to FreeSWITCH/ESL directly. See TESTING.md.
TELEPHONY_ENABLED=false
TELEPHONY_WORKER_URL="http://127.0.0.1:18005"
# Shared secret between this app and telephony-worker/worker.env's TELEPHONY_WORKER_SECRET —
# generate a real random value and set it identically on both sides; never commit either .env.
TELEPHONY_WORKER_SECRET=""
CONNECTEL_CALLER_ID_NUMBER=""

# Email (bank statement delivery). MAIL_MAILER=log (the default if unset) never sends anything
# over the network — NotificationsService just records/logs it. Set MAIL_MAILER=smtp plus the
# four values below (any standard SMTP server, e.g. a Gmail address + app password on
# smtp.gmail.com:587, or an https://ethereal.email sandbox test account for a real send with no
# real recipient) to enable real delivery — no code change either way.
MAIL_MAILER=log
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="Barq Bank Support"
